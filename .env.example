# База: postgres://… для production; pglite:./data/pglite или pglite:memory для разработки
DATABASE_URL=pglite:./data/pglite
NODE_ENV=development
PORT=3000
# dev: переключатель пользователей; header: доверенный заголовок от identity-aware proxy с MFA
AUTH_MODE=dev
SEED_DEMO=1
# Ключ шифрования токенов (в production из KMS)
SECRETS_KEY=
# LinkedIn (оставьте пустым, пока приложение не создано: работа через assisted-процессы)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:3000/oauth/linkedin/callback
# Продукты, одобренные НАШЕМУ приложению, через запятую, точными названиями:
# Sign In with LinkedIn using OpenID Connect,Share on LinkedIn,Community Management API
LINKEDIN_APPROVED_PRODUCTS=
LINKEDIN_API_VERSION=202608
# demo (по умолчанию, без сети) или http (реальный Posts API)
LINKEDIN_ADAPTER=demo
MEMBER_DAILY_REQUEST_BUDGET=100
WORKER_INTERVAL_MS=5000
