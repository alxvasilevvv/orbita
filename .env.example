# База: postgres://… для production; pglite:./data/pglite или pglite:memory для разработки
DATABASE_URL=pglite:./data/pglite
NODE_ENV=development
PORT=3000
# dev: переключатель пользователей; header: доверенный заголовок от identity-aware proxy с MFA
AUTH_MODE=dev
SEED_DEMO=1
# Ключ шифрования токенов (в production из KMS)
SECRETS_KEY=
# LinkedIn (оставьте пустым, пока приложение не создано: работа через assisted-процессы)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:3000/oauth/linkedin/callback
# Продукты, одобренные НАШЕМУ приложению, через запятую, точными названиями:
# Sign In with LinkedIn using OpenID Connect,Share on LinkedIn,Community Management API
LINKEDIN_APPROVED_PRODUCTS=
LINKEDIN_API_VERSION=202608
# demo (по умолчанию, без сети) или http (реальный Posts API)
LINKEDIN_ADAPTER=demo
MEMBER_DAILY_REQUEST_BUDGET=100
WORKER_INTERVAL_MS=5000
# Пул соединений PostgreSQL на процесс
DB_POOL_MAX=30
# Исполнитель в том же процессе, что и API (только вне production; 0 = запускать npm run worker отдельно)
INLINE_WORKER=1
# Лимит запросов API на пользователя в минуту (основная защита: WAF)
API_RATE_LIMIT_PER_MIN=600
TRUST_PROXY=0
# Файлы: локально (подписанные ссылки) или S3
FILES_DIR=./data/files
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
# Антивирус для загрузок (без него проверяются сигнатуры форматов и тестовый EICAR)
CLAMAV_HOST=
CLAMAV_PORT=3310
# AI: anthropic | openai_compatible | пусто (демо-провайдер с явной пометкой)
AI_PROVIDER=
ANTHROPIC_API_KEY=
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_DISABLED=0
# Использование данных LinkedIn API в AI и выгрузках только после подтверждения разрешённых целей
LINKEDIN_DATA_AI_ALLOWED=0
LINKEDIN_DATA_EXPORT_ALLOWED=0
# Уведомления
APP_URL=http://localhost:3000
MAIL_FROM=
POSTMARK_TOKEN=
NOTIFY_WEBHOOK_URL=
# Экономика и хранение
# INFRA_COST_MONTH_USD=1200
BACKUP_RETENTION_DAYS=35
DAILY_ENGAGEMENT_CAP=15
