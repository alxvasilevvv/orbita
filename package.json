{
  "name": "orbita",
  "version": "1.0.0",
  "description": "Orbita: AI-агенты ведут соцсети команды на автопилоте",
  "scripts": {
    "dev": "npm run build:ui && tsx src/server/main.ts",
    "worker": "tsx src/worker/main.ts",
    "build:ui": "esbuild src/ui/main.tsx --bundle --outfile=public/app.js --jsx=automatic --minify --define:process.env.NODE_ENV=\\\"production\\\"",
    "migrate": "tsx src/db/migrate-cli.ts",
    "seed": "tsx src/db/seed-cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "i18n:check": "tsx scripts/i18n-check.ts",
    "loadtest": "tsx scripts/loadtest.ts",
    "test:pg": "TEST_PG_ADMIN_URL=${TEST_PG_ADMIN_URL:-postgres://postgres@localhost:5432/postgres} vitest run",
    "e2e": "mkdir -p e2e/shots && node e2e/flow.mjs && node e2e/b2b.mjs && node e2e/autopilot.mjs && node e2e/smoke.mjs",
    "build": "npm run build:ui",
    "start": "NODE_ENV=development AUTH_MODE=dev SEED_DEMO=1 INLINE_WORKER=1 node --import tsx src/server/main.ts"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1145.0",
    "@aws-sdk/s3-request-presigner": "^3.1145.0",
    "@electric-sql/pglite": "^0.5.8",
    "fastify": "^5.12.5",
    "pg": "^8.23.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.6.5",
    "tsx": "^4.23.15",
    "esbuild": "^0.28.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  }
}